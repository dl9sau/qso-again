<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:subtitleTextAppearance="@style/ToolbarSubtitle"
        app:logo="@drawable/ic_launcher_foreground" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_recording"
                android:textSize="12sp"
                android:gravity="center"
                android:padding="4dp" />

            <ProgressBar
                android:id="@+id/progressRecording"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRecordingTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnStartStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/record"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/play"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/save"
                    android:layout_margin="2dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/speed"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnSpeedDown"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="-"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btnSpeedDefault"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/speed_default"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btnSpeedUp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="+"
                    android:layout_margin="2dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPlaybackSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvPlaybackProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0:00 / 0:00"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekBarPlayback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seek_back_label"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seconds"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn0s"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="0s"
                    android:backgroundTint="#2196F3"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn2s"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="2s"
                    android:tag="2s"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn5s"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="5s"
                    android:tag="5s"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn10s"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="10s"
                    android:tag="10s"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn20s"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="20s"
                    android:tag="20s"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn30s"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="30s"
                    android:tag="30s"
                    android:layout_margin="1dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/minutes"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn1m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="1min"
                    android:tag="1m"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn2m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="2min"
                    android:tag="2m"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn5m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="5min"
                    android:tag="5m"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn10m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="10min"
                    android:tag="10m"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn30m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="30min"
                    android:tag="30m"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn60m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="60min"
                    android:tag="60m"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnBeginning"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/seek_beginning"
                    android:backgroundTint="#2196F3"
                    android:layout_margin="1dp"
                    android:textSize="10sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_recordings"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecordings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>